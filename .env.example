# ──────────────────────────────────────────────────
#  Polymarket Arbitrage Swarm — Configuration
# ──────────────────────────────────────────────────

# ── Polymarket API ──
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLY_FUNDER=
POLY_CHAIN_ID=137
POLY_SIGNATURE_TYPE=0

# ── Claude API (for news → edge analysis) ──
ANTHROPIC_API_KEY=sk-ant-XXXXX
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── Trading Parameters ──
TRADING_BANKROLL=1000.0
TRADING_MAX_POSITION_PCT=0.20
TRADING_KELLY_FRACTION=0.5
TRADING_MIN_EDGE=0.05
TRADING_MIN_PROFIT_USD=2.0
TRADING_MAX_OPEN_POSITIONS=10
TRADING_STOP_LOSS_PCT=0.50
TRADING_TAKE_PROFIT_PCT=3.0

# IMPORTANT: Set to false to enable real trading
TRADING_DRY_RUN=true

# ── News Feeds ──
NEWS_POLL_INTERVAL_SEC=120
NEWS_RSS_FEEDS=https://feeds.arstechnica.com/arstechnica/technology-lab,https://www.reddit.com/r/MachineLearning/.rss,https://hnrss.org/frontpage
NEWS_KEYWORDS=polymarket,prediction market,AI model,benchmark,election,poll,resign,impeach,indictment,sanctions,ceasefire,rate cut,rate hike,FDA approval,Supreme Court,executive order,launched,released,announced

# ── Swarm ──
SWARM_SCAN_INTERVAL_SEC=30
SWARM_LOG_LEVEL=INFO
